# --- Telegram -------------------------------------------------------------
# Токен від @BotFather. НЕ комітити.
TELEGRAM_BOT_TOKEN=
# ID групи/каналу. Дізнатись: docker compose run --rm silpo-alco-watch chatid
TELEGRAM_CHAT_ID=
# Для груп із темами (topics) — id теми. Інакше лишити порожнім.
TELEGRAM_THREAD_ID=

# --- Що моніторимо --------------------------------------------------------
# Формат: <branchId>:<людська назва>. Кілька філій — через ";" (назва містить кому).
# Знайти branchId: docker compose run --rm silpo-alco-watch branches --search "Львів"
SILPO_BRANCHES=1ee60f26-91ca-6348-9f46-7975b9b60b08:Сільпо, Білогородка, вул. Будівельна, 19

# Доступні групи: strong, wine_still, wine_sparkling, vermouth, beer, cider, nonalco
SILPO_CATEGORY_GROUPS=strong,beer,cider,vermouth

# Асортимент якої схеми брати. SelfPickup = те, що реально лежить у магазині.
SILPO_DELIVERY_TYPE=SelfPickup

# Мінімальна знижка у відсотках (рахується від РЕАЛЬНОЇ ціни, коли є історія).
MIN_DISCOUNT_PERCENT=0

# Не писати про те, чого немає на полиці.
ONLY_IN_STOCK=true

# true = пропускати акції з міткою "тільки онлайн" (вони не діють на касі).
# Лишено false: у повідомленні такі акції позначені "🌐 тільки онлайн".
EXCLUDE_ONLINE_ONLY=false

# --- Розклад --------------------------------------------------------------
# Раз на добу: історія цін будується по одному замiру на день.
SCHEDULE_TIMES=09:00
TZ=Europe/Kyiv
# Зробити прохід одразу при старті контейнера.
RUN_ON_START=true

# --- Поведінка сповіщень --------------------------------------------------
# off  = нічого не постити самому; бот відповідає ЛИШЕ на команди.
#        Щоденний обхід каталогу все одно виконується — він будує історію цін.
# top1 = одне повідомлення про товар з найбільшою знижкою, і лише коли
#        лідер змінився. all = писати про кожну нову акцію.
NOTIFY_MODE=off

# Стосується лише NOTIFY_MODE=all: перший запуск наповнює базу без спаму.
SEED_ON_FIRST_RUN=true
# У режимі top1: писати ще раз, якщо в того самого лідера змінилась ціна.
# У режимі all: писати повторно, якщо ціна впала ще нижче.
NOTIFY_ON_PRICE_DROP=true
# Стеля повідомлень за один прохід (лише для NOTIFY_MODE=all).
MAX_MESSAGES_PER_RUN=25
# Пауза між повідомленнями: Telegram дозволяє ~20/хв у групу.
MESSAGE_DELAY_SECONDS=3.5
# Через скільки днів забути позицію, щоб повторна акція знову вважалась новою.
PRUNE_AFTER_DAYS=21

# --- Команди в чаті -------------------------------------------------------
# Слухати команди (/пиво, /горілка, /vodka…) і відповідати топ-1 по категорії.
ENABLE_COMMANDS=true

# --- Історія цін ----------------------------------------------------------
# Щодня знімати ціни всього алкогольного каталогу (~1600 позицій, ~10 с).
# Без цього неможливо відрізнити справжню знижку від накрученої.
TRACK_PRICE_HISTORY=true

# Скільки точок ціни показувати в динаміці.
HISTORY_POINTS=4

# Ранжувати за реальною знижкою (від нашої базової ціни), а не за плашкою.
RANK_BY_HONEST_DISCOUNT=true

# --- Службове -------------------------------------------------------------
STATE_PATH=/data/state.db
LOG_LEVEL=INFO
# true = нічого не надсилати, лише вивести в лог.
DRY_RUN=false
